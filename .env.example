# ===================================================================
# Sistema de Ofertas - variaveis de ambiente
# Copie este arquivo para .env e preencha os valores necessarios:
#   cp .env.example .env
# NUNCA faça commit do arquivo .env (ele já está no .gitignore).
# ===================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# Token legado de acesso ao painel administrativo (/admin).
# Ainda aceito, mas o login principal agora e e-mail + senha.
ADMIN_TOKEN=admin

# Conta administrativa criada automaticamente na primeira execucao.
ADMIN_EMAIL=admin@ofertas.local
ADMIN_PASSWORD=admin
ADMIN_NAME=Administrador
SESSION_DAYS=30

# --- Banco de dados ---
# sqlite (padrão, zero configuração) ou postgres
DB_DRIVER=sqlite
SQLITE_PATH=./data/ofertas.db

# Usado apenas quando DB_DRIVER=postgres (ex.: Supabase)
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@<host>:5432/postgres

# --- Rastreador ---
TRACK_INTERVAL_MINUTES=15
TRACK_ON_START=true

# --- Fonte de demonstração ---
DEMO_SOURCE_ENABLED=true

# --- Fonte Shopee (Affiliate Open API) ---
# Obtenha as credenciais em https://affiliate.shopee.com.br/open_api
SHOPEE_ENABLED=false
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_KEYWORDS=notebook,celular,smart tv

# --- Fonte TikTok Shop (Open API) ---
# Obtenha as credenciais no TikTok Shop Partner Center
TIKTOK_ENABLED=false
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=
TIKTOK_API_URL=https://open-api.tiktokglobalshop.com
TIKTOK_KEYWORDS=notebook,celular

# --- IA (opcional; o sistema funciona 100% por regras sem ela) ---
# Use variaveis proprias deste projeto. Informe sua propria chave de API.
AI_ENABLED=false
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini

# --- WhatsApp (futuro - API oficial Cloud) ---
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_RECIPIENTS=
